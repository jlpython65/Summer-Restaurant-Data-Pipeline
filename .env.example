# Example environment variables template
# Copy this into a real .env file and replace the placeholder values.

GOOGLE_DEVELOPER_KEY=your_google_developer_key_here
GOOGLE_CLIENT_SECRET_FILE=Google/credentials.json
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_ACCOUNT_ID=your_google_account_id_here
GOOGLE_ACCOUNT_EMAIL=your_google_account_email_here
GOOGLE_SHEET_ID=your_google_sheet_id_here
GOOGLE_DRIVE_FILE_ID=your_google_drive_file_id_here
OCR_API_KEY=your_ocr_api_key_here

# Optional project-specific credentials
# DATABASE_URL=your_database_url_here
# SECRET_KEY=your_secret_key_here
